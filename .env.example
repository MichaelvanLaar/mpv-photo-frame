# ============================================================
# mpv-photo-frame — configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# Required: your photo/video library, as one source folder per line.
# Optionally skip folders by adding  | excl1,excl2  after the path (comma-separated,
# relative to that source folder). Excludes can be:
#   - a direct subfolder name:       raw
#   - a deeper relative path:        2020/raw   (sub-sub-folder)
#   - a glob matching any depth:     */raw      (all folders named "raw" at any depth)
# Lines starting with # are ignored, so you can comment a source out.
#
# Examples:
#   SLIDESHOW_SOURCES="/path/to/your/photos"
#   SLIDESHOW_SOURCES="
#     /home/me/Pictures/Holidays | private,raw
#     /home/me/Pictures/Family   | 2023/Unedited        # exact sub-sub-folder
#     /mnt/nas/Scans             | */RAW,*/Thumbnails   # glob: all RAW/Thumbnails dirs
#   "
SLIDESHOW_SOURCES="/path/to/your/photos"

# Seconds to display each image (default: 10)
SLIDESHOW_DELAY=10

# Where to store the TIFF→JPEG conversion cache
# (created automatically; uncomment to override)
# SLIDESHOW_TIFF_CACHE="${HOME}/.cache/slideshow-tiff-cache"

# Where to store the generated playlist file
# (created automatically; uncomment to override)
# SLIDESHOW_PLAYLIST="${HOME}/.cache/slideshow-playlist.m3u"

# If your photos live on cloud or network storage (rclone, sshfs, SMB, etc.),
# set this to the systemd service that mounts that storage.
# install.sh will add an After= dependency so the playlist is only generated
# once the mount is ready. Example: "rclone-onedrive.service"
# SLIDESHOW_AFTER_SERVICE=""

# --- Compilations (multiple slideshows) ---------------------------------
# Create profiles/<name>.env overriding any variable above (at minimum
# SLIDESHOW_SOURCES), then run:   ./slideshow.sh <name>
# List them with:             ./slideshow.sh --list
#
# Do NOT set SLIDESHOW_PLAYLIST in this shared .env when using compilations:
# each compilation automatically gets its own cache at
# ~/.cache/slideshow-playlist-<name>.m3u. A single profile may set it for a
# custom path, but setting it here would make all compilations collide on one
# file.

# --- Overlay (date/filename caption) ------------------------------------
# All optional; each falls back to a sensible default if unset.
# SLIDESHOW_OVERLAY_FONT="DejaVu Sans"     # any installed font name
# SLIDESHOW_OVERLAY_SIZE=medium            # small | medium | large | xlarge
# SLIDESHOW_OVERLAY_COLOR=FFFFFF           # text fill, hex RRGGBB (no leading #)
# SLIDESHOW_OVERLAY_OUTLINE=000000         # text outline, hex RRGGBB (no leading #)
# SLIDESHOW_OVERLAY_POSITION=bottom-left   # bottom-left | bottom-right | top-left | top-right
# SLIDESHOW_OVERLAY_LANG=                  # en | de | fr | es  (empty = system language, then en)
# SLIDESHOW_OVERLAY_CLOCK=                 # 12 | 24            (empty = language default)
