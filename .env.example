# ============================================================
# mpv-photo-frame — configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# Required: absolute path to your photo/video library
SLIDESHOW_BASE="/path/to/your/photos"

# Seconds to display each image (default: 10)
SLIDESHOW_DELAY=10

# Subdirectories of SLIDESHOW_BASE to skip (comma-separated).
# Leave empty or comment out to include all subdirectories.
# SLIDESHOW_EXCLUDE="folder1,folder2"

# Where to store the TIFF→JPEG conversion cache
# (created automatically; uncomment to override)
# SLIDESHOW_TIFF_CACHE="${HOME}/.cache/slideshow-tiff-cache"

# Where to store the generated playlist file
# (created automatically; uncomment to override)
# SLIDESHOW_PLAYLIST="${HOME}/.cache/slideshow-playlist.m3u"

# If your photos live on cloud or network storage (rclone, sshfs, SMB, etc.),
# set this to the systemd service that mounts that storage.
# install.sh will add an After= dependency so the playlist is only generated
# once the mount is ready. Example: "rclone-onedrive.service"
# SLIDESHOW_AFTER_SERVICE=""

# --- Compilations (multiple slideshows) ---------------------------------
# Create profiles/<name>.env overriding any variable above (at minimum
# SLIDESHOW_BASE), then run:   ./slideshow.sh <name>
# List them with:             ./slideshow.sh --list
#
# Do NOT set SLIDESHOW_PLAYLIST in this shared .env when using compilations:
# each compilation automatically gets its own cache at
# ~/.cache/slideshow-playlist-<name>.m3u. A single profile may set it for a
# custom path, but setting it here would make all compilations collide on one
# file.