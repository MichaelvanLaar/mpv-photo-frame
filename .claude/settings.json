{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(shellcheck:*)",
      "Bash(shfmt:*)",
      "Bash(luacheck:*)",
      "Bash(bash tests/:*)"
    ],
    "deny": [
      "Read(./secrets/**)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "filepath=$(jq -r '.tool_input.file_path // empty'); case \"$filepath\" in *.sh) command -v shfmt >/dev/null 2>&1 && shfmt -i 2 -w \"$filepath\" 2>/dev/null || true ;; esac"
          }
        ]
      }
    ]
  }
}
