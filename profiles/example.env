# Example compilation (profile) for mpv-photo-frame.
# Copy this to <name>.env in this folder, then play it with:
#   ./slideshow.sh <name>
# List all compilations with:  ./slideshow.sh --list
#
# A compilation is layered on top of the shared ../.env: anything you leave
# unset here falls back to ../.env, then to the script's built-in default.
# You may override ANY SLIDESHOW_* variable (see ../.env.example).

# Source folders for this compilation, one per line (required unless already
# set in ../.env). Optionally add  | sub1,sub2  after a path to skip subfolders
# of it (relative to that path):
SLIDESHOW_SOURCES="
  /home/you/Pictures/Holidays | private,raw
"

# Optional: override any other setting, e.g. a faster cadence for this one:
#SLIDESHOW_DELAY=6

# Leave SLIDESHOW_PLAYLIST unset: each compilation automatically gets its own
# cache at ~/.cache/slideshow-playlist-<name>.m3u. Only set it here if you want
# a custom cache path for THIS compilation.
